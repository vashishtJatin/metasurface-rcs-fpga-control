## Configuration Voltage and I/O Voltage Defaults
set_property CFGBVS VCCO [current_design]
set_property CONFIG_VOLTAGE 3.3 [current_design]
## --------------------------------------------------------------------
## Slide Switches (SW0 - SW15) -> Inputs
## --------------------------------------------------------------------
set_property PACKAGE_PIN V17 [get_ports {sw1}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw1}]
set_property PACKAGE_PIN V16 [get_ports {sw2}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw2}]
set_property PACKAGE_PIN W16 [get_ports {sw3}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw3}]
set_property PACKAGE_PIN W17 [get_ports {sw4}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw4}]
set_property PACKAGE_PIN W15 [get_ports {sw5}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw5}]
set_property PACKAGE_PIN V15 [get_ports {sw6}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw6}]
set_property PACKAGE_PIN W14 [get_ports {sw7}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw7}]
set_property PACKAGE_PIN W13 [get_ports {sw8}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw8}]
set_property PACKAGE_PIN V2 [get_ports {sw9}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw9}]
set_property PACKAGE_PIN T3 [get_ports {sw10}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw10}]
set_property PACKAGE_PIN T2 [get_ports {sw11}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw11}]
set_property PACKAGE_PIN R3 [get_ports {sw12}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw12}]
set_property PACKAGE_PIN W2 [get_ports {sw13}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw13}]
set_property PACKAGE_PIN U1 [get_ports {sw14}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw14}]
set_property PACKAGE_PIN T1 [get_ports {sw15}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw15}]
set_property PACKAGE_PIN R2 [get_ports {sw16}]
set_property IOSTANDARD LVCMOS33 [get_ports {sw16}]

## --------------------------------------------------------------------
## PMOD Header JA & JB -> Outputs to Diode Driver Circuit
## --------------------------------------------------------------------
# PMOD JA Pins (pin1 to pin8)
set_property PACKAGE_PIN J1 [get_ports {pin1}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin1}]
set_property PACKAGE_PIN L2 [get_ports {pin2}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin2}]
set_property PACKAGE_PIN J2 [get_ports {pin3}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin3}]
set_property PACKAGE_PIN G2 [get_ports {pin4}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin4}]
set_property PACKAGE_PIN H1 [get_ports {pin5}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin5}]
set_property PACKAGE_PIN K2 [get_ports {pin6}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin6}]
set_property PACKAGE_PIN H2 [get_ports {pin7}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin7}]
set_property PACKAGE_PIN G3 [get_ports {pin8}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin8}]
# PMOD JB Pins (pin9 to pin16)
set_property PACKAGE_PIN A14 [get_ports {pin9}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin9}]
set_property PACKAGE_PIN A16 [get_ports {pin10}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin10}]
set_property PACKAGE_PIN B15 [get_ports {pin11}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin11}]
set_property PACKAGE_PIN B16 [get_ports {pin12}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin12}]
set_property PACKAGE_PIN A15 [get_ports {pin13}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin13}]
set_property PACKAGE_PIN A17 [get_ports {pin14}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin14}]
set_property PACKAGE_PIN C15 [get_ports {pin15}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin15}]
set_property PACKAGE_PIN C16 [get_ports {pin16}]
set_property IOSTANDARD LVCMOS33 [get_ports {pin16}]
